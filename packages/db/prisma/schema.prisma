generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Всегда в lowercase — нормализуется в zod-схеме.
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  categories   Category[]
  transactions Transaction[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  /// #rrggbb в lowercase — нормализуется в zod-схеме.
  color     String
  /// Имя иконки lucide в kebab-case.
  icon      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  // Покрывает и выборку категорий по userId, отдельный индекс не нужен.
  @@unique([userId, name])
  @@map("categories")
}

enum TransactionType {
  INCOME
  EXPENSE

  @@map("transaction_type")
}

model Transaction {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  categoryId  String          @map("category_id") @db.Uuid
  /// Всегда > 0, направление задаёт type.
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  description String?
  /// Только дата, без времени и часового пояса.
  date        DateTime        @db.Date
  createdAt   DateTime        @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: категорию с транзакциями удалить нельзя (409), история не пропадает молча.
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Список с фильтром по датам и summary за месяц.
  @@index([userId, date])
  // Проверка Restrict при удалении категории и фильтр по категории.
  @@index([categoryId])
  @@map("transactions")
}
