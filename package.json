{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Трекер расходов: Next.js + NestJS + Prisma/Postgres",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run start:dev -w @expense-tracker/api\" \"npm run dev -w @expense-tracker/web\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "npm run generate -w @expense-tracker/db",
    "db:migrate": "npm run migrate:dev -w @expense-tracker/db --",
    "db:studio": "npm run studio -w @expense-tracker/db"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
